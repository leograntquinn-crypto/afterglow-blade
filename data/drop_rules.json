    "increment": "once per non-legend draw with eligible legends",
    "reset_on_legend": true
  },
  "pityMisses": 8,
  "rarity_scaling": {
    "clamp_order": [
      "maxRar masks weights",
      "minRar floor",
      "maxRar ceiling"
    ],
    "common_unscaled": true,
    "formula": "i=0: w; i>0: w*(1+L*0.05+luck)*(i=4 ? 1+L*0.06 : 1)",
