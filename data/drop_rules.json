  "schema_version": 1,
  "selection_order": [
    "cosmetic availability",
    "legend source and boss mixing",
    "rarity and pity",
    "unseen priority",
    "weighted series",
    "weighted kind (slot weight divided by kind count)",
    "uniform definition"
  ],
  "sell": {
    "cost_tier": [
      0,
      1,
      2,
      2.5,
      3
