    "chest": 0.22,
    "helm": 0.22,
    "trinket": 0.22,
    "weapon": 0.34
  },
  "pity": {
    "counter_keys": [
      "boss:{boss}",
      "clear:{stage}:{diff}",
      "{source}"
    ],
